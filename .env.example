# Copy to .env (gitignored) and fill in real values.
# Loaded automatically by .envrc when you enter the Nix dev shell via direnv.

# ---- Required for any live REST/WS call ----
FYERS_CLIENT_ID=APPID-100
FYERS_ACCESS_TOKEN=

# ---- Auth flow (examples/auth_*) ----
# Used by auth_generate_access_token.rs and auth_refresh_token.rs.
FYERS_SECRET_KEY=
FYERS_REDIRECT_URI=https://127.0.0.1/fyers/callback
FYERS_AUTH_CODE=
FYERS_REFRESH_TOKEN=
FYERS_PIN=

# ---- Live integration tests (cargo test --features live-tests) ----
# tests/support/mod.rs reads these; symbol/date vars have safe defaults.
FYERS_LIVE_SYMBOL=NSE:SBIN-EQ
FYERS_LIVE_INDEX_SYMBOL=NSE:NIFTY50-INDEX
FYERS_LIVE_OPTION_CHAIN_SYMBOL=NSE:NIFTY50-INDEX
FYERS_LIVE_HISTORY_FROM=2024-01-01
FYERS_LIVE_HISTORY_TO=2024-01-31

# ---- Order examples (DANGER: real broker calls when set to 1) ----
# Leave unset/0 unless you intentionally want to place or modify a live order.
FYERS_PLACE_LIVE_ORDER=0
FYERS_MUTATE_LIVE_ORDER=0
FYERS_ORDER_ID=
